l=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor" target="show_value"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n6" value="" style="endArrow=none;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor" target="show_sheet"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n7" value="" style="endArrow=none;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor" target="run_file"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n8" value="" style="endArrow=none;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor" target="exit"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n9" value="" style="endArrow=none;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor" target="edit"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="process" value="Process formula" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="850" y="360" width="300" height="60" as="geometry" /></mxCell><mxCell id="n18" value="" style="endArrow=open;endFill=1;dashed=1;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.88;entryY=0.17;entryDx=0;entryDy=0;" edge="1" parent="1" source="process" target="edit"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n19" value="«extend»" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="n18"><mxGeometry x="-0.4" relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell><mxCell id="cond" value="Condition: {content starts with '='}&lt;br&gt;extension point: content type" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;size=18;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="850" y="470" width="300" height="60" as="geometry" /></mxCell><mxCell id="n20" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="cond" target="n18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="notes" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;A cell is identified by its coordinate (column letters + row number, e.g. A1). Its content is text, a number or a formula, and every option that touches one cell asks for the coordinate first.&lt;br&gt;&lt;br&gt;Parsing and evaluating a formula only happens when the new content starts with '=', so it is an extension of Edit cell. Loading a file always processes its formulas, so Load spreadsheet includes it.&lt;br&gt;&lt;br&gt;Rejecting circular dependencies and recomputing the dependent cells are steps and alternative flows of Edit cell and Load spreadsheet, not use cases of their own.&lt;br&gt;&lt;br&gt;Run commands from file reads one option per line and runs it as if the user had typed it. Which options run depends on the file, so it is not drawn as including them." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;size=18;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="850" y="790" width="480" height="240" as="geometry" /></mxCell><mxCell id="inc_load_process" value="" edge="1" parent="1" source="load" target="process" style="endArrow=open;endFill=1;dashed=1;html=1;rounded=0;exitX=0.85;exitY=0.9;exitDx=0;exitDy=0;entryX=0.12;entryY=0.15;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="inc_load_process_label" value="«include»" vertex="1" connectable="0" parent="inc_load_process" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];"><mxGeometry x="0.55" relative="1" as="geometry"><mxPoint x="12" y="-12" as="offset" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>