<mxfile host="app.diagrams.net"><diagram name="Use case diagram" id="Use-case-diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Spreadsheet - use case diagram&lt;/font&gt;&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry" /></mxCell><mxCell id="box" value="Spreadsheet" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;align=left;verticalAlign=top;fontStyle=1;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="1080" height="1080" as="geometry" /></mxCell><mxCell id="actor" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="90" y="560" width="40" height="80" as="geometry" /></mxCell><mxCell id="create" value="Create spreadsheet" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="390" y="120" width="300" height="60" as="geometry" /></mxCell><mxCell id="load" value="Load spreadsheet" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="390" y="210" width="300" height="60" as="geometry" /></mxCell><mxCell id="save" value="Save spreadsheet" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="390" y="300" width="300" height="60" as="geometry" /></mxCell><mxCell id="show_content" value="Show cell content" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="390" y="510" width="300" height="60" as="geometry" /></mxCell><mxCell id="show_value" value="Show cell value" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><m